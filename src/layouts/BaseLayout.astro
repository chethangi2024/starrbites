---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import OverlayMenu from '../components/OverlayMenu.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface ArticleSchemaInput {
  headline: string;
  description: string;
  datePublished: string;
  image: string;
  category: string;
}

interface Props {
  title: string;
  description?: string;
  transparentHero?: boolean;
  heroMinimalHeader?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noTitleSuffix?: boolean;
  articleSchema?: ArticleSchemaInput;
}

const {
  title,
  description = SITE.tagline,
  transparentHero = false,
  heroMinimalHeader = false,
  ogImage = '/brand/og-default.jpg',
  ogType = 'website',
  noTitleSuffix = false,
  articleSchema,
} = Astro.props;

const siteBase = 'https://www.starrbites.com';
const fullTitle =
  noTitleSuffix || title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;

const cleanPath =
  Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = new URL(cleanPath, siteBase).toString();
const absoluteOgImage = new URL(ogImage, siteBase).toString();

const activeSocials = SITE.social
  .map((item) => item.href)
  .filter((href) => href && href !== '#');

const orgSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'RealEstateAgent'],
  name: SITE.name,
  url: siteBase,
  logo: new URL('/brand/logo.png', siteBase).toString(),
  image: new URL('/brand/og-default.jpg', siteBase).toString(),
  email: SITE.email,
  telephone: SITE.phones.map((p) => p.display),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'No. 194, 3rd Main, 13th Cross, RMV 2nd Stage, HIG Dollars Colony',
    addressLocality: 'Bengaluru',
    addressRegion: 'Karnataka',
    postalCode: '560094',
    addressCountry: 'IN',
  },
};

if (activeSocials.length > 0) {
  orgSchema.sameAs = activeSocials;
}

const articleJsonLd = articleSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: articleSchema.headline,
      description: articleSchema.description,
      datePublished: articleSchema.datePublished,
      articleSection: articleSchema.category,
      image: [new URL(articleSchema.image, siteBase).toString()],
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
      },
      author: {
        '@type': 'Organization',
        name: SITE.name,
        url: siteBase,
      },
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        logo: {
          '@type': 'ImageObject',
          url: new URL('/brand/logo.png', siteBase).toString(),
        },
      },
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF7F0" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Twitter -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Favicons & Web App Manifest -->
    <link rel="icon" type="image/png" href="/brand/favicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google Fonts: Cormorant Garamond (500) & Manrope (400, 500, 600) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=Manrope:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {
      articleJsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
      )
    }
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <Header transparentHero={transparentHero} heroMinimalHeader={heroMinimalHeader} />
    <OverlayMenu />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
