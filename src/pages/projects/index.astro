---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MediaSlot from '../../components/MediaSlot.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects"
  description="Curated land developments by StarrBites, starting with Tiiger Trail – Phase I in Sri Sathya Sai District."
  transparentHero={true}
>
  <PageHero
    eyebrow="Projects"
    title="Our destinations"
    lead="Plotted developments planned for daily living and long-term ownership."
    mediaSrc="/media/projects-hero.jpg"
    mediaAlt="Aerial view of green fields with long tree shadows at sunset."
  />

  <section class="section" aria-labelledby="projects-list-heading">
    <div class="container projects__stack">
      <h2 id="projects-list-heading" class="sr-only">StarrBites destinations</h2>

      {
        projects.map((project) => (
          <article class="project-feature" data-reveal>
            <div class="project-feature__media">
              <a href={`/projects/${project.id}`} aria-label={`Explore ${project.data.title}`}>
                <MediaSlot
                  src={project.data.heroImage}
                  alt={project.data.heroAlt}
                  ratio="16/9"
                  zoomOnHover={true}
                />
              </a>
            </div>

            <div class="project-feature__body">
              <p class="eyebrow">Flagship destination</p>
              <h3 class="project-feature__title">{project.data.title}</h3>
              <p class="project-feature__tagline">{project.data.tagline}</p>
              <p class="project-feature__location">{project.data.location}</p>
              <p class="project-feature__desc">{project.data.summary}</p>
              <div class="project-feature__actions">
                <a href={`/projects/${project.id}`} class="btn btn--primary">
                  View project details
                </a>
                {project.data.externalUrl && (
                  <a
                    href={project.data.externalUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn--outline"
                  >
                    Visit tiigertrail.com
                    <span aria-hidden="true">↗</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }

      <!-- Upcoming Card -->
      <article class="project-upcoming" data-reveal>
        <div class="project-upcoming__content">
          <p class="eyebrow">Upcoming</p>
          <h3 class="project-upcoming__title">More destinations coming soon</h3>
          <p class="project-upcoming__desc">
            We are planning our next curated land destinations. Leave your details if you would like to hear when new phases open.
          </p>
        </div>
        <div class="project-upcoming__action">
          <a href="/contact" class="btn btn--outline">Talk to us to hear first</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .projects__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .project-feature {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 1024px) {
    .project-feature {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-6);
      padding: var(--space-5);
    }
  }

  .project-feature__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .project-feature__title {
    font-size: var(--text-2xl);
  }

  @media (min-width: 1024px) {
    .project-feature__title {
      font-size: var(--text-3xl);
    }
  }

  .project-feature__tagline {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: var(--leading-heading);
    color: var(--color-accent-text);
  }

  .project-feature__location {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .project-feature__desc {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  .project-feature__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .project-upcoming {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-base);
    border: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 1024px) {
    .project-upcoming {
      flex-direction: row;
      align-items: center;
      padding: var(--space-5) var(--space-6);
    }
  }

  .project-upcoming__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project-upcoming__title {
    font-size: var(--text-xl);
  }

  .project-upcoming__desc {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  .project-upcoming__action {
    flex-shrink: 0;
  }
</style>
