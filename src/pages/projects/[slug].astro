---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ClosingCta from '../../components/home/ClosingCta.astro';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const p = project.data;
---

<BaseLayout
  title={p.title}
  description={p.summary}
  transparentHero={true}
  ogImage={p.heroImage}
>
  <PageHero
    eyebrow={p.location}
    title={p.title}
    lead={`${p.tagline} — ${p.summary}`}
    mediaSrc={p.heroImage}
    mediaAlt={p.heroAlt}
  />

  <!-- Action Bar -->
  <section class="project-bar" aria-label="Project actions">
    <div class="container project-bar__inner">
      <div class="project-bar__meta">
        <a href="/projects" class="project-bar__back">
          <span aria-hidden="true">←</span> All projects
        </a>
        <span class="project-bar__status">{p.status}</span>
      </div>

      <div class="project-bar__actions">
        <a href="/contact" class="btn btn--primary">Book a site visit</a>
        {
          p.brochureUrl && (
            <a href={p.brochureUrl} class="btn btn--outline">
              Download brochure
            </a>
          )
        }
        {
          p.externalUrl && (
            <a
              href={p.externalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--outline"
            >
              Visit tiigertrail.com
              <span aria-hidden="true">↗</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="section surface-light" aria-labelledby="overview-heading">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Overview</p>
        <h2 id="overview-heading" class="section-head__title">About {p.title}</h2>
      </div>

      <div class="overview__copy" data-reveal>
        {p.overviewParagraphs.map((para) => <p class="overview__para">{para}</p>)}
      </div>

      <div class="pillars-grid">
        {
          p.pillars.map((item) => (
            <article class="pillar-box" data-reveal>
              <h3 class="pillar-box__title">{item.title}</h3>
              <p class="pillar-box__text">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Location & Connectivity -->
  <section class="section project-section" aria-labelledby="location-heading">
    <div class="container location__grid">
      <div class="location__intro" data-reveal>
        <p class="eyebrow">Location</p>
        <h2 id="location-heading" class="section-head__title">A Strategic Location</h2>
        <p class="location__badge">{p.location}</p>
        {p.locationIntro.map((para) => <p class="location__text">{para}</p>)}
        {
          p.mapUrl && (
            <div class="location__actions">
              <a
                href={p.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--outline"
              >
                Open location on Google Maps
                <span aria-hidden="true">↗</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </div>
          )
        }
      </div>

      <div class="connectivity-card" data-reveal>
        <h3 class="connectivity-card__title">Connectivity &amp; Growth Hub Access</h3>
        <ul class="connectivity-list">
          {
            p.connectivity.map((hub) => (
              <li class="connectivity-list__item">
                <p class="connectivity-list__name">{hub.name}</p>
                <p class="connectivity-list__detail">{hub.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Amenities -->
  <section class="section project-section" aria-labelledby="amenities-heading">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Lifestyle &amp; Amenities</p>
        <h2 id="amenities-heading" class="section-head__title">Pre-Planned Lifestyle Experiences</h2>
      </div>

      <div class="pillars-grid">
        {
          p.lifestyleAmenities.map((item) => (
            <article class="amenity-card" data-reveal>
              <h3 class="amenity-card__title">{item.title}</h3>
              <p class="amenity-card__text">{item.description}</p>
            </article>
          ))
        }
      </div>

      <div class="club-amenities" data-reveal>
        <h3 class="club-amenities__heading">Club &amp; Recreation Amenities</h3>
        <div class="club-amenities__grid">
          {
            p.clubAmenities.map((item) => (
              <div class="club-pill">
                <span class="eyebrow">{item.category}</span>
                <p class="club-pill__name">{item.name}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Master Plan -->
  <section class="section surface-light project-section" aria-labelledby="master-plan-heading">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Architectural Blueprint</p>
        <h2 id="master-plan-heading" class="section-head__title">{p.title} Master Plan</h2>
        {p.masterPlanIntro && <p class="section-head__lead">{p.masterPlanIntro}</p>}
      </div>

      <div class="master-plan__grid">
        {
          p.masterPlanImage && (
            <div class="master-plan__media" data-reveal>
              <img
                src={p.masterPlanImage}
                alt={p.masterPlanAlt ?? `${p.title} master plan`}
                width="1414"
                height="2000"
                loading="lazy"
                decoding="async"
                class="master-plan__img"
              />
            </div>
          )
        }

        <div class="master-plan__specs" data-reveal>
          {
            p.masterPlanSpecs.map((spec) => (
              <div class="spec-item">
                <h3 class="spec-item__title">{spec.title}</h3>
                <p class="spec-item__text">{spec.description}</p>
              </div>
            ))
          }

          {p.plotSizesNote && <p class="placeholder-note">{p.plotSizesNote}</p>}

          <div id="brochure-placeholder" class="brochure-box">
            <p class="eyebrow">Brochure</p>
            <p class="brochure-box__text">
              {p.brochureNote ?? 'Brochure PDF link to be added.'}
            </p>
            <div class="brochure-box__actions">
              <a href="/contact" class="btn btn--primary">Request brochure &amp; site visit</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="section project-section" aria-labelledby="gallery-heading">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Gallery</p>
        <h2 id="gallery-heading" class="section-head__title">{p.title} Gallery</h2>
      </div>

      <div class="gallery-grid">
        {
          p.gallery.map((img) => (
            <figure class="gallery-card" data-reveal>
              <img
                src={img.src}
                alt={img.alt}
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
                class="gallery-card__img"
              />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <ClosingCta
    heading={`Interested in ${p.title}?`}
    text="Book a guided site visit or speak with our Bengaluru team for master plan details and availability."
    ctaLabel="Book a site visit"
    ctaHref="/contact"
  />
</BaseLayout>

<style>
  .project-bar {
    background-color: var(--color-surface-raised);
    border-bottom: 1px solid var(--color-border-subtle);
    padding-block: var(--space-4);
  }

  .project-bar__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  @media (min-width: 1024px) {
    .project-bar__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .project-bar__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .project-bar__back {
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-accent-text);
  }

  .project-bar__status {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    background-color: var(--color-highlight);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
  }

  .project-bar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .project-section {
    border-top: 1px solid var(--color-border-subtle);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .section-head__title {
    font-size: var(--text-2xl);
  }

  @media (min-width: 1024px) {
    .section-head__title {
      font-size: var(--text-3xl);
    }
  }

  .section-head__lead {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .overview__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .overview__para {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .pillars-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .pillars-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .pillar-box,
  .amenity-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
  }

  .pillar-box__title,
  .amenity-card__title {
    font-size: var(--text-xl);
  }

  .pillar-box__text,
  .amenity-card__text {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  /* Location */
  .location__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .location__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-7);
    }
  }

  .location__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .location__badge {
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .location__text {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  .location__actions {
    margin-top: var(--space-2);
  }

  .connectivity-card {
    padding: var(--space-5) var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .connectivity-card__title {
    font-size: var(--text-xl);
  }

  .connectivity-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .connectivity-list__item {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .connectivity-list__name {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .connectivity-list__detail {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  /* Club Amenities */
  .club-amenities {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .club-amenities__heading {
    font-size: var(--text-2xl);
  }

  .club-amenities__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (min-width: 1024px) {
    .club-amenities__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  .club-pill {
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-light);
    border: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .club-pill__name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  /* Master Plan */
  .master-plan__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .master-plan__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--space-7);
    }
  }

  .master-plan__media {
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    background-color: var(--color-surface-raised);
  }

  .master-plan__img {
    width: 100%;
    height: auto;
  }

  .master-plan__specs {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .spec-item {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .spec-item__title {
    font-size: var(--text-xl);
  }

  .spec-item__text {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  .placeholder-note {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px dashed var(--color-border-input);
    background-color: var(--color-surface-base);
  }

  .brochure-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
  }

  .brochure-box__text {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  /* Gallery */
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .gallery-card {
    margin: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    background-color: var(--color-surface-raised);
    aspect-ratio: 16 / 10;
  }

  .gallery-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
