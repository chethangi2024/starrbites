---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ClosingCta from '../components/home/ClosingCta.astro';

const steps = [
  {
    number: '01',
    title: 'Talk to us',
    text: 'Share your goals, timeline, and budget on a call scheduled in your time zone.',
  },
  {
    number: '02',
    title: 'Shortlist the right plot',
    text: 'Review layouts, location context, and guided virtual walkthroughs to narrow down suitable plots.',
  },
  {
    number: '03',
    title: 'Legal checks and documentation',
    text: 'We share the document set for your independent review and coordinate with your legal advisor as needed.',
  },
  {
    number: '04',
    title: 'Registration and ongoing support',
    text: 'We help coordinate registration steps and remain a point of contact for ongoing site updates.',
  },
];

const supportItems = [
  {
    title: 'Legal and documentation support',
    text: 'Organised access to title papers, layout documents, and step-by-step checklists so you or your advisor can review everything clearly.',
  },
  {
    title: 'Virtual site visits',
    text: 'Live video walkthroughs of the site, surrounding roads, and shortlisted plots so you can inspect the ground from overseas.',
  },
  {
    title: 'Coordination for registration',
    text: 'Scheduling guidance and on-ground coordination for in-person registration or authorised Power of Attorney workflows.',
  },
  {
    title: 'Ongoing property management',
    text: 'Periodic site check-ins, maintenance coordination, and practical local support after your plot is registered.',
  },
];

const faqs = [
  {
    id: 'faq-nri-buy',
    question: 'Can NRIs buy plots in India?',
    answer:
      'In general, Non-Resident Indians (NRIs) and Overseas Citizens of India (OCIs) are permitted under Indian foreign-exchange rules to purchase residential plotted land, subject to applicable regulations. Agricultural land, plantation land, and farmhouses carry separate restrictions.',
  },
  {
    id: 'faq-visit-in-person',
    question: 'Do I need to visit in person?',
    answer:
      'An in-person visit is welcome but not always required. Many overseas buyers shortlist plots through virtual walkthroughs and, where permitted, complete registration through a duly executed Power of Attorney.',
  },
  {
    id: 'faq-payments-abroad',
    question: 'How do payments work from abroad?',
    answer:
      'Payments for property purchases in India are typically routed through regular banking channels — such as NRE, NRO, or FCNR accounts, or direct inward remittance — in line with prevailing RBI and banking guidelines.',
  },
  {
    id: 'faq-paperwork',
    question: 'Who handles the paperwork?',
    answer:
      'Our team helps prepare and organise the transaction paperwork, shares documents for your review, and coordinates with your legal or tax advisor so every step is clear before you sign.',
  },
  {
    id: 'faq-manage-after',
    question: 'Can you manage the property after purchase?',
    answer:
      'We intend to stay connected after handover — assisting with basic site coordination, periodic updates, and local guidance while you hold the land or prepare to build.',
  },
];
---

<BaseLayout
  title="NRI"
  description="Invest in plotted land in Bengaluru from anywhere in the world, with clear guidance and support from StarrBites."
  transparentHero={true}
>
  <PageHero
    eyebrow="NRI & Global Buyers"
    title="Invest in India from anywhere"
    lead="A structured, transparent process for NRIs and overseas families looking to own land in and around Bengaluru."
    mediaSrc="/media/nri-hero.jpg"
    mediaAlt="Morning light over open green landscape in India"
  />

  <!-- 4-Step Process -->
  <section class="section" aria-labelledby="nri-process-heading">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">How It Works</p>
        <h2 id="nri-process-heading" class="section-head__title">
          Four Clear Steps
        </h2>
      </div>

      <ol class="steps-grid">
        {
          steps.map((step) => (
            <li class="step-card" data-reveal>
              <p class="eyebrow">{step.number}</p>
              <h3 class="step-card__title">{step.title}</h3>
              <p class="step-card__text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- What We Help With -->
  <section class="section nri-support" aria-labelledby="nri-support-heading">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Advisory &amp; Coordination</p>
        <h2 id="nri-support-heading" class="section-head__title">
          What We Help With
        </h2>
      </div>

      <div class="support-grid">
        {
          supportItems.map((item) => (
            <article class="support-card" data-reveal>
              <h3 class="support-card__title">{item.title}</h3>
              <p class="support-card__text">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ Accordion -->
  <section class="section nri-faq" aria-labelledby="nri-faq-heading">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Common Questions</p>
        <h2 id="nri-faq-heading" class="section-head__title">
          NRI Buying FAQs
        </h2>
      </div>

      <div class="faq-list" data-faq-accordion data-reveal>
        {
          faqs.map((item) => (
            <div class="faq-item">
              <h3 class="faq-item__heading">
                <button
                  type="button"
                  class="faq-item__trigger"
                  id={`${item.id}-trigger`}
                  aria-expanded="false"
                  aria-controls={`${item.id}-panel`}
                  data-faq-trigger
                >
                  <span>{item.question}</span>
                  <span class="faq-item__icon" aria-hidden="true">+</span>
                </button>
              </h3>
              <div
                id={`${item.id}-panel`}
                class="faq-item__panel"
                role="region"
                aria-labelledby={`${item.id}-trigger`}
                hidden
              >
                <p class="faq-item__answer">{item.answer}</p>
              </div>
            </div>
          ))
        }
      </div>

      <p class="faq-disclaimer" data-reveal>
        This is general information, not legal or tax advice. Rules can change — we'll confirm the details for your situation.
      </p>
    </div>
  </section>

  <ClosingCta
    heading="Planning a purchase from abroad?"
    text="Schedule a call with our Bengaluru team at a time that works in your time zone."
    ctaLabel="Talk to us"
    ctaHref="/contact"
  />
</BaseLayout>

<style>
  .section-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .section-head__title {
    font-size: var(--text-2xl);
  }

  @media (min-width: 1024px) {
    .section-head__title {
      font-size: var(--text-3xl);
    }
  }

  .steps-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .steps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .steps-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .step-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
  }

  .step-card__title {
    font-size: var(--text-xl);
  }

  .step-card__text {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  .nri-support,
  .nri-faq {
    border-top: 1px solid var(--color-border-subtle);
  }

  .support-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 1024px) {
    .support-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  .support-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .support-card__title {
    font-size: var(--text-xl);
  }

  .support-card__text {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border-subtle);
    max-width: 880px;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .faq-item__heading {
    margin: 0;
  }

  .faq-item__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    padding-inline: 0;
    background: transparent;
    border: 0;
    text-align: left;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-text-primary);
    cursor: pointer;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .faq-item__trigger:hover {
    color: var(--color-accent);
  }

  .faq-item__trigger:active {
    opacity: 0.85;
  }

  .faq-item__icon {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--color-accent);
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .faq-item__trigger[aria-expanded='true'] .faq-item__icon {
    transform: rotate(45deg);
  }

  .faq-item__panel {
    padding-bottom: var(--space-4);
  }

  .faq-item__answer {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  .faq-disclaimer {
    margin-top: var(--space-5);
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }
</style>

<script>
  const accordion = document.querySelector<HTMLElement>('[data-faq-accordion]');
  if (accordion) {
    const triggers = Array.from(
      accordion.querySelectorAll<HTMLButtonElement>('[data-faq-trigger]')
    );

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        const expanded = trigger.getAttribute('aria-expanded') === 'true';
        const panelId = trigger.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;

        trigger.setAttribute('aria-expanded', String(!expanded));
        if (panel) {
          panel.hidden = expanded;
        }
      });

      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          triggers[(index + 1) % triggers.length]?.focus();
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          triggers[(index - 1 + triggers.length) % triggers.length]?.focus();
        } else if (event.key === 'Home') {
          event.preventDefault();
          triggers[0]?.focus();
        } else if (event.key === 'End') {
          event.preventDefault();
          triggers[triggers.length - 1]?.focus();
        }
      });
    });
  }
</script>
