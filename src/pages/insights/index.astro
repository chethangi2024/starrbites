---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MediaSlot from '../../components/MediaSlot.astro';
import ClosingCta from '../../components/home/ClosingCta.astro';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = ['All', 'News', 'Guides'] as const;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-IN', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
---

<BaseLayout
  title="Insights"
  description="News, guides and updates for land buyers and investors."
  transparentHero={true}
>
  <PageHero
    eyebrow="Insights"
    title="Insights"
    lead="News, guides and updates for land buyers and investors."
    mediaSrc="/media/insights-hero.jpg"
    mediaAlt="Open green land and trees around Bengaluru"
  />

  <section class="section" aria-labelledby="insights-list-heading">
    <div class="container">
      <div class="insights-toolbar" data-reveal>
        <h2 id="insights-list-heading" class="sr-only">Filter articles by category</h2>
        <div class="insights-filters" role="group" aria-label="Filter insights by category">
          {
            categories.map((category, index) => (
              <button
                type="button"
                class:list={['btn', index === 0 ? 'btn--primary' : 'btn--outline', 'filter-btn']}
                data-filter-btn={category}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {category}
              </button>
            ))
          }
        </div>
        <p class="insights-count" data-filter-count aria-live="polite">
          Showing {posts.length} {posts.length === 1 ? 'article' : 'articles'}
        </p>
      </div>

      <div class="insights-grid" data-insights-grid>
        {
          posts.map((post) => {
            const cover = post.data.coverImage ?? `/media/insights/${post.id}.jpg`;
            const coverAlt = post.data.coverAlt ?? `Cover image for ${post.data.title}`;
            return (
              <article
                class="insight-card"
                data-insight-card
                data-category={post.data.category}
                data-reveal
              >
                <a href={`/insights/${post.id}`} class="insight-card__link">
                  <MediaSlot src={cover} alt={coverAlt} ratio="16/10" zoomOnHover={true} />
                  <div class="insight-card__body">
                    <div class="insight-card__meta">
                      <span class="eyebrow">{post.data.category}</span>
                      <time
                        datetime={post.data.pubDate.toISOString()}
                        class="insight-card__date"
                      >
                        {formatDate(post.data.pubDate)}
                      </time>
                    </div>
                    <h3 class="insight-card__title">{post.data.title}</h3>
                    <p class="insight-card__desc">{post.data.description}</p>
                    <span class="insight-card__cta">
                      Read more <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>

      <div
        class="media-placeholder insights-empty"
        data-insights-empty
        hidden={posts.length > 0}
      >
        <p class="insights-empty__text">No posts in this category yet.</p>
      </div>
    </div>
  </section>

  <ClosingCta
    heading="Have a question about buying land in Bengaluru?"
    text="Speak with our team for clear guidance on plots, documentation, or NRI ownership."
    ctaLabel="Talk to us"
    ctaHref="/contact"
  />
</BaseLayout>

<style>
  .insights-toolbar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .insights-toolbar {
      flex-direction: row;
      align-items: center;
    }
  }

  .insights-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .filter-btn {
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
  }

  .insights-count {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  .insights-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .insights-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (min-width: 1024px) {
    .insights-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .insight-card {
    display: flex;
  }

  .insight-card[hidden] {
    display: none;
  }

  .insight-card__link {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-primary);
    transition:
      border-color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
  }

  .insight-card__link:hover {
    opacity: 1;
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .insight-card__link:active {
    transform: translateY(0);
  }

  .insight-card__body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }

  .insight-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .insight-card__date {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .insight-card__title {
    font-size: var(--text-xl);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .insight-card__desc {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    flex: 1 1 auto;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .insight-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-accent);
  }

  .insights-empty {
    min-height: 220px;
  }

  .insights-empty[hidden] {
    display: none;
  }

  .insights-empty__text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .insight-card__link:hover {
      transform: none;
    }
  }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-insight-card]'));
  const emptyState = document.querySelector<HTMLElement>('[data-insights-empty]');
  const countEl = document.querySelector<HTMLElement>('[data-filter-count]');

  if (buttons.length > 0) {
    const applyFilter = (category: string) => {
      let visibleCount = 0;

      cards.forEach((card) => {
        const matches = category === 'All' || card.dataset.category === category;
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      });

      buttons.forEach((btn) => {
        const isSelected = btn.dataset.filterBtn === category;
        btn.setAttribute('aria-pressed', String(isSelected));
        btn.classList.toggle('btn--primary', isSelected);
        btn.classList.toggle('btn--outline', !isSelected);
      });

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }

      if (countEl) {
        countEl.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'article' : 'articles'}`;
      }
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.dataset.filterBtn ?? 'All';
        applyFilter(category);
      });
    });
  }
</script>
