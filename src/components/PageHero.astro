---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  mediaSrc: string;
  mediaAlt?: string;
}

const { eyebrow, title, lead, mediaSrc, mediaAlt = '' } = Astro.props;

const relativePath = mediaSrc.replace(/^\/+/, '');
const webpRelativePath = relativePath.replace(/\.(jpe?g|png)$/i, '.webp');

const hasWebp = fs.existsSync(path.join(process.cwd(), 'public', webpRelativePath));
const hasOriginal = fs.existsSync(path.join(process.cwd(), 'public', relativePath));
const resolvedSrc = hasWebp ? `/${webpRelativePath}` : hasOriginal ? mediaSrc : null;
---

<section class="page-hero" aria-labelledby="page-hero-title">
  <div class="page-hero__media" aria-hidden="true">
    {
      resolvedSrc ? (
        <img
          src={resolvedSrc}
          alt={mediaAlt}
          width="1920"
          height="1080"
          class="page-hero__img"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      ) : (
        <div class="page-hero__placeholder">
          <span class="page-hero__placeholder-label">Media slot · {relativePath}</span>
        </div>
      )
    }
    <div class="page-hero__overlay"></div>
  </div>

  <div class="container page-hero__content">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="page-hero-title" class="page-hero__title">{title}</h1>
    {lead && <p class="page-hero__lead">{lead}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    min-height: 52dvh;
    display: flex;
    align-items: flex-end;
    padding-top: calc(var(--header-height) + var(--space-7));
    padding-bottom: var(--space-6);
    background-color: var(--color-surface-hero-dark);
    color: var(--color-text-on-dark);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 1024px) {
    .page-hero {
      min-height: 56dvh;
      padding-bottom: var(--space-7);
    }
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero__img,
  .page-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__placeholder {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: calc(var(--header-height) + var(--space-4)) var(--space-5);
    background-color: var(--color-surface-raised);
  }

  .page-hero__placeholder-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    opacity: 0.7;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--color-overlay-hero);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .page-hero .eyebrow {
    color: var(--color-text-on-dark);
  }

  .page-hero__title {
    font-size: var(--text-3xl);
    color: var(--color-text-on-dark);
    max-width: 18ch;
  }

  @media (min-width: 1024px) {
    .page-hero__title {
      font-size: var(--text-4xl);
    }
  }

  .page-hero__lead {
    font-size: var(--text-lg);
    color: var(--color-text-on-dark-muted);
    max-width: 56ch;
  }
</style>
