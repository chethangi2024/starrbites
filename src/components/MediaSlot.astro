---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  src: string;
  alt: string;
  placeholderLabel?: string;
  ratio?: '16/10' | '16/9' | '21/9' | '4/3';
  objectPosition?: string;
  eager?: boolean;
  zoomOnHover?: boolean;
  revealScale?: boolean;
  class?: string;
}

const {
  src,
  alt,
  placeholderLabel,
  ratio = '16/10',
  objectPosition = 'center center',
  eager = false,
  zoomOnHover = false,
  revealScale = false,
  class: className = '',
} = Astro.props;

const dimensions = {
  '16/10': { width: 1600, height: 1000 },
  '16/9': { width: 1600, height: 900 },
  '21/9': { width: 2100, height: 900 },
  '4/3': { width: 1200, height: 900 },
}[ratio];

const relativePath = src.replace(/^\/+/, '');
const webpRelativePath = relativePath.replace(/\.(jpe?g|png)$/i, '.webp');

const hasWebp = fs.existsSync(path.join(process.cwd(), 'public', webpRelativePath));
const hasOriginal = fs.existsSync(path.join(process.cwd(), 'public', relativePath));

const resolvedSrc = hasWebp ? `/${webpRelativePath}` : hasOriginal ? src : null;
const displayLabel = placeholderLabel ?? relativePath;
---

<div
  class:list={[
    'media-slot',
    {
      'media-slot--zoom': zoomOnHover,
      'media-slot--cinematic': ratio === '21/9',
    },
    className,
  ]}
  style={`--media-ratio: ${ratio === '21/9' ? '16 / 10' : ratio}; --media-pos: ${objectPosition};`}
  data-reveal-scale={revealScale ? '' : undefined}
>
  {
    resolvedSrc ? (
      <img
        src={resolvedSrc}
        alt={alt}
        width={dimensions.width}
        height={dimensions.height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : undefined}
        class="media-slot__img"
      />
    ) : (
      <div class="media-slot__placeholder" role="img" aria-label={alt}>
        <span class="media-slot__badge">Media slot</span>
        <span class="media-slot__file">{displayLabel}</span>
      </div>
    )
  }
</div>

<style>
  .media-slot {
    position: relative;
    width: 100%;
    aspect-ratio: var(--media-ratio, 16 / 10);
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 768px) {
    .media-slot--cinematic {
      aspect-ratio: 21 / 9;
    }
  }

  .media-slot__img,
  .media-slot__placeholder {
    width: 100%;
    height: 100%;
    transition: transform var(--motion-slow) var(--ease-out);
  }

  .media-slot__img {
    object-fit: cover;
    object-position: var(--media-pos, center center);
  }

  .media-slot__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4);
    text-align: center;
    background-color: var(--color-surface-raised);
  }

  .media-slot__badge {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .media-slot__file {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    word-break: break-word;
  }

  :global(a:hover) .media-slot--zoom .media-slot__img,
  :global(a:hover) .media-slot--zoom .media-slot__placeholder,
  :global(a:focus-visible) .media-slot--zoom .media-slot__img,
  :global(a:focus-visible) .media-slot--zoom .media-slot__placeholder,
  .media-slot--zoom:hover .media-slot__img,
  .media-slot--zoom:hover .media-slot__placeholder {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .media-slot__img,
    .media-slot__placeholder {
      transition: none;
    }

    :global(a:hover) .media-slot--zoom .media-slot__img,
    :global(a:hover) .media-slot--zoom .media-slot__placeholder,
    :global(a:focus-visible) .media-slot--zoom .media-slot__img,
    :global(a:focus-visible) .media-slot--zoom .media-slot__placeholder,
    .media-slot--zoom:hover .media-slot__img,
    .media-slot--zoom:hover .media-slot__placeholder {
      transform: none;
    }
  }
</style>
