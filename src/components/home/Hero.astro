---
import fs from 'node:fs';
import path from 'node:path';

const videoSrc = '/media/hero.mp4';
const hasWebpPoster = fs.existsSync(path.join(process.cwd(), 'public', 'media', 'hero-poster.webp'));
const hasJpgPoster = fs.existsSync(path.join(process.cwd(), 'public', 'media', 'hero-poster.jpg'));
const posterSrc = hasWebpPoster ? '/media/hero-poster.webp' : '/media/hero-poster.jpg';

const hasVideo = fs.existsSync(path.join(process.cwd(), 'public', 'media', 'hero.mp4'));
const hasPoster = hasWebpPoster || hasJpgPoster;

const word1Letters = 'STARR'.split('');
const word2Letters = 'BITES'.split('');
---

<section class="hero" data-home-hero aria-labelledby="home-hero-title">
  <div class="hero__media" aria-hidden="true">
    {
      hasVideo ? (
        <>
          <video
            class="hero__video"
            data-hero-video
            muted
            loop
            playsinline
            preload="metadata"
            poster={hasPoster ? posterSrc : undefined}
          >
            <source src={videoSrc} type="video/mp4" />
          </video>
          {hasPoster && (
            <img
              src={posterSrc}
              alt=""
              width="1920"
              height="1080"
              class="hero__poster hero__poster--reduced"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          )}
        </>
      ) : hasPoster ? (
        <img
          src={posterSrc}
          alt=""
          width="1920"
          height="1080"
          class="hero__poster"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      ) : (
        <div class="hero__placeholder">
          <span class="hero__placeholder-label">Video slot · media/hero.mp4 &amp; media/hero-poster.webp</span>
        </div>
      )
    }
    <div class="hero__overlay"></div>
  </div>

  <!-- Stage 1: Opening Screen -->
  <div class="hero__stage hero__stage--1" data-hero-stage-1>
    <div class="container hero__opening">
      <h1 id="home-hero-title" class="hero__opening-title" aria-label="Welcome to Starr Bites">
        <span class="hero__welcome" aria-hidden="true" data-hero-welcome>Welcome to</span>

        <span class="hero__star" aria-hidden="true" data-hero-star>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <defs>
              <linearGradient id="starrbites-star-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#D69F38" />
                <stop offset="100%" stop-color="#FEDE6E" />
              </linearGradient>
            </defs>
            <path
              d="M12 1.5L14.3 9.7L22.5 12L14.3 14.3L12 22.5L9.7 14.3L1.5 12L9.7 9.7L12 1.5Z"
              fill="url(#starrbites-star-grad)"
            />
          </svg>
        </span>

        <span class="hero__wordmark" aria-hidden="true">
          <span class="hero__word" data-hero-word="1">
            {
              word1Letters.map((letter) => (
                <span class="hero__letter" data-hero-letter>
                  {letter}
                </span>
              ))
            }
          </span>
          <span class="hero__word" data-hero-word="2">
            {
              word2Letters.map((letter) => (
                <span class="hero__letter" data-hero-letter>
                  {letter}
                </span>
              ))
            }
          </span>
        </span>
      </h1>
    </div>

    <div class="hero__scroll-cue" data-hero-scroll-cue aria-hidden="true">
      <span class="hero__scroll-label">Scroll</span>
      <span class="hero__scroll-line">
        <span class="hero__scroll-line-fill"></span>
      </span>
    </div>
  </div>

  <!-- Stage 2: Hero Message (revealed on scroll) -->
  <div class="hero__stage hero__stage--2" data-hero-stage-2>
    <div class="container hero__content">
      <p class="eyebrow">StarrBites, Bengaluru</p>
      <h2 class="hero__title">
        Land that <span class="highlight">grows with you</span>
      </h2>
      <p class="hero__lead">
        Plotted land destinations from a Bengaluru-based developer, for building a home or investing for the long term.
      </p>

      <div class="hero__actions">
        <a href="/projects/tiiger-trail" class="btn btn--primary">Explore Tiiger Trail</a>
        <a href="/contact" class="btn btn--outline">Talk to us</a>
      </div>
    </div>
  </div>

  <!-- Persistent video pause control -->
  <div class="hero__controls">
    <button
      type="button"
      class="btn btn--outline hero__pause-btn"
      data-hero-toggle
      aria-pressed="false"
      aria-label="Pause background video"
      disabled={!hasVideo}
    >
      <span data-hero-toggle-label>{hasVideo ? 'Pause video' : 'Video slot ready'}</span>
    </button>
  </div>
</section>
<div class="hero-end-sentinel" data-hero-end aria-hidden="true"></div>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    background-color: var(--color-surface-hero-dark);
    color: var(--color-text-on-dark);
    overflow: hidden;
  }

  .hero-end-sentinel {
    width: 100%;
    height: 1px;
    margin-top: -1px;
    pointer-events: none;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__video,
  .hero__poster,
  .hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__poster--reduced {
    display: none;
  }

  .hero__placeholder {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: calc(var(--header-height) + var(--space-4)) var(--space-5);
    background-color: var(--color-surface-hero-dark);
  }

  .hero__placeholder-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-on-dark-muted);
    opacity: 0.7;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--color-overlay-hero);
  }

  /* Two overlaid stages inside the pinned 100dvh viewport */
  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .hero__stage--1 {
    align-items: center;
    justify-content: center;
    padding-top: var(--header-height);
    padding-bottom: calc(var(--space-7) + var(--space-3));
  }

  .hero__opening {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hero__opening-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    color: var(--color-text-on-dark);
  }

  .hero__welcome {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-text-on-dark-muted);
    padding-left: 0.28em;
  }

  @media (min-width: 640px) {
    .hero__welcome {
      font-size: var(--text-sm);
    }
  }

  .hero__star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  .hero__wordmark {
    --letter-gap: clamp(0.42em, 3.8vw, 0.72em);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    row-gap: var(--space-3);
    max-width: 100%;
    font-family: var(--font-heading);
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text-on-dark);
    font-size: clamp(2.25rem, 10vw, 3rem);
  }

  .hero__word {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    gap: var(--letter-gap);
  }

  @media (min-width: 640px) {
    .hero__wordmark {
      --letter-gap: clamp(0.6rem, 2.4vw, 1.5rem);
      flex-direction: row;
      flex-wrap: nowrap;
      column-gap: calc(var(--letter-gap) * 2.5);
      row-gap: 0;
      font-size: clamp(2rem, 4.4vw, 3.25rem);
    }
  }

  @media (min-width: 1024px) {
    .hero__wordmark {
      --letter-gap: clamp(1.25rem, 3.2vw, 2.75rem);
      column-gap: calc(var(--letter-gap) * 2.5);
      font-size: clamp(2.75rem, 4.2vw, 4.25rem);
    }
  }

  .hero__letter {
    display: inline-block;
    will-change: opacity, transform;
  }

  /* Scroll cue at bottom centre */
  .hero__scroll-cue {
    position: absolute;
    inset-block-end: var(--space-4);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    pointer-events: none;
  }

  .hero__scroll-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-on-dark-muted);
    padding-left: 0.2em;
  }

  .hero__scroll-line {
    position: relative;
    display: block;
    width: 1px;
    height: 44px;
    background-color: rgba(255, 255, 255, 0.22);
    overflow: hidden;
  }

  .hero__scroll-line-fill {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    height: 100%;
    background: var(--color-accent-gradient);
    transform-origin: top center;
    animation: scroll-line-drop 2.2s var(--ease-out) infinite;
  }

  @keyframes scroll-line-drop {
    0% {
      transform: scaleY(0);
      transform-origin: top center;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top center;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom center;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom center;
    }
  }

  /* Stage 2: Hero Message */
  .hero__stage--2 {
    justify-content: flex-end;
    padding-top: calc(var(--header-height) + var(--space-6));
    padding-bottom: calc(var(--space-6) + var(--space-5));
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .hero__stage--2 {
      padding-bottom: var(--space-7);
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .hero .eyebrow {
    color: var(--color-text-on-dark);
  }

  .hero__title {
    font-size: var(--text-4xl);
    text-transform: uppercase;
    color: var(--color-text-on-dark);
    max-width: 14ch;
  }

  .hero__lead {
    font-size: var(--text-lg);
    color: var(--color-text-on-dark-muted);
    max-width: 52ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero :global(.btn--outline) {
    color: var(--color-text-on-dark);
    border-color: var(--color-border-on-dark);
  }

  .hero :global(.btn--outline:hover) {
    background-color: var(--color-surface-on-dark-hover);
    border-color: var(--color-text-on-dark);
    color: var(--color-text-on-dark);
  }

  .hero :focus-visible {
    outline-color: var(--color-accent);
  }

  /* Persistent pause button */
  .hero__controls {
    position: absolute;
    inset-block-end: var(--space-4);
    inset-inline-end: var(--space-4);
    z-index: 4;
  }

  @media (min-width: 1024px) {
    .hero__controls {
      inset-block-end: var(--space-5);
      inset-inline-end: var(--space-5);
    }
  }

  .hero__pause-btn {
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  /* Reduced motion: stacked full-height sections, poster image, no pinning or letter animation */
  @media (prefers-reduced-motion: reduce) {
    .hero {
      min-height: auto;
    }

    .hero__video {
      display: none;
    }

    .hero__poster--reduced {
      display: block;
    }

    .hero__stage {
      position: relative;
      inset: auto;
      min-height: 100dvh;
    }

    .hero__stage--2 {
      opacity: 1;
      pointer-events: auto;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }

    .hero__scroll-line-fill {
      animation: none;
      transform: scaleY(1);
    }

    .hero__controls {
      display: none;
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggleBtn = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  const toggleLabel = document.querySelector<HTMLElement>('[data-hero-toggle-label]');

  if (video && toggleBtn && toggleLabel) {
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    const syncUI = (paused: boolean) => {
      toggleBtn.setAttribute('aria-pressed', String(paused));
      toggleBtn.setAttribute(
        'aria-label',
        paused ? 'Play background video' : 'Pause background video'
      );
      toggleLabel.textContent = paused ? 'Play video' : 'Pause video';
    };

    const applyMotionPreference = () => {
      if (reducedMotionQuery.matches) {
        video.pause();
        syncUI(true);
      } else {
        video
          .play()
          .then(() => syncUI(false))
          .catch(() => syncUI(true));
      }
    };

    applyMotionPreference();
    reducedMotionQuery.addEventListener('change', applyMotionPreference);

    toggleBtn.addEventListener('click', () => {
      if (video.paused) {
        video
          .play()
          .then(() => syncUI(false))
          .catch(() => syncUI(true));
      } else {
        video.pause();
        syncUI(true);
      }
    });
  }
</script>
