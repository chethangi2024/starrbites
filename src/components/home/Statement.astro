<section class="section surface-light statement" aria-labelledby="statement-heading">
  <div class="container statement__inner" data-reveal>
    <p id="statement-heading" class="eyebrow">Our Philosophy</p>
    <hr class="divider-gold statement__rule" />
    <p class="statement__text">
      Land is the quiet foundation of everything worth building. When chosen with care, planned with restraint, and held with patience, it becomes more than an address — it becomes space for a slower life, steadier long-term growth, and a legacy that stays with your family for generations.
    </p>
  </div>
</section>

<style>
  .statement__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .statement__rule {
    max-width: 120px;
    margin: 0;
  }

  .statement__text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-text-on-light);
    max-width: 34ch;
  }

  @media (min-width: 1024px) {
    .statement__text {
      font-size: var(--text-2xl);
    }
  }
</style>
