---
---

<section class="surface-light statement" aria-labelledby="statement-heading">
  <div class="container statement__grid" data-reveal>
    <div class="statement__aside">
      <p id="statement-heading" class="eyebrow">Our philosophy</p>
      <hr class="divider-gold statement__rule" />
    </div>

    <p class="statement__text">
      Good land holds its place across generations. We choose land with care and plan it for families who want to live on it or pass it down.
    </p>
  </div>
</section>

<style>
  .statement {
    padding-block: var(--space-6);
  }

  @media (min-width: 1024px) {
    .statement {
      padding-block: var(--space-8);
    }
  }

  .statement__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .statement__grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      gap: var(--space-6);
    }
  }

  .statement__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .statement__rule {
    max-width: 96px;
    margin: 0;
  }

  .statement__text {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-text-primary);
    max-width: 28ch;
  }

  @media (min-width: 1024px) {
    .statement__text {
      font-size: var(--text-3xl);
      line-height: 1.2;
    }
  }
</style>
