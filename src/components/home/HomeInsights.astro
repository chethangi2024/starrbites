---
import { getCollection } from 'astro:content';
import MediaSlot from '../MediaSlot.astro';

const latestPosts = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-IN', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
---

<section class="section home-insights" aria-labelledby="home-insights-heading">
  <div class="container">
    <div class="home-insights__header" data-reveal>
      <div class="home-insights__title-wrap">
        <p class="eyebrow">Insights</p>
        <h2 id="home-insights-heading" class="home-insights__heading">
          Notes on Land &amp; Ownership
        </h2>
      </div>
      <a href="/insights" class="btn btn--outline">View all insights</a>
    </div>

    {
      latestPosts.length === 0 ? (
        <div class="media-placeholder home-insights__empty" data-reveal>
          <p class="home-insights__empty-title">No posts in this category yet.</p>
          <p class="home-insights__empty-note">
            Guides and updates on Bengaluru land ownership and NRI buying will appear here once published.
          </p>
        </div>
      ) : (
        <div class="home-insights__grid">
          {latestPosts.map((post) => {
            const cover = post.data.coverImage ?? `/media/insights/${post.id}.jpg`;
            const coverAlt = post.data.coverAlt ?? `Cover image for ${post.data.title}`;
            return (
              <article class="insight-card" data-reveal>
                <a href={`/insights/${post.id}`} class="insight-card__link">
                  <MediaSlot src={cover} alt={coverAlt} ratio="16/10" zoomOnHover={true} />
                  <div class="insight-card__body">
                    <div class="insight-card__meta">
                      <span class="eyebrow">{post.data.category}</span>
                      <time
                        datetime={post.data.pubDate.toISOString()}
                        class="insight-card__date"
                      >
                        {formatDate(post.data.pubDate)}
                      </time>
                    </div>
                    <h3 class="insight-card__title">{post.data.title}</h3>
                    <p class="insight-card__desc">{post.data.description}</p>
                    <span class="insight-card__cta">
                      Read more <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      )
    }
  </div>
</section>

<style>
  .home-insights__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .home-insights__header {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .home-insights__title-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .home-insights__heading {
    font-size: var(--text-2xl);
  }

  @media (min-width: 1024px) {
    .home-insights__heading {
      font-size: var(--text-3xl);
    }
  }

  .home-insights__empty {
    min-height: 220px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .home-insights__empty-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
  }

  .home-insights__empty-note {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  .home-insights__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 1024px) {
    .home-insights__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .insight-card {
    display: flex;
  }

  .insight-card__link {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-primary);
    transition:
      border-color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
  }

  .insight-card__link:hover {
    opacity: 1;
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .insight-card__link:active {
    transform: translateY(0);
  }

  .insight-card__body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }

  .insight-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .insight-card__date {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .insight-card__title {
    font-size: var(--text-xl);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .insight-card__desc {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    flex: 1 1 auto;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .insight-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .insight-card__link:hover {
      transform: none;
    }
  }
</style>
