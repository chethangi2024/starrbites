---
import MediaSlot from '../MediaSlot.astro';

const pillars = [
  {
    eyebrow: '01 Land ownership',
    title: 'Invest in land',
    description:
      'Plotted developments chosen for daily living and long-term ownership.',
    href: '/projects',
    image: '/media/pillar-land.jpg',
    alt: 'Green fields and trees across rolling countryside in soft morning light.',
  },
  {
    eyebrow: '02 Destinations',
    title: 'Curated destinations',
    description:
      'Sites chosen for tree cover, calm internal roads, and road connectivity.',
    href: '/projects/tiiger-trail',
    image: '/media/pillar-destinations.jpg',
    alt: 'Tree-lined road shaded by green canopy.',
  },
  {
    eyebrow: '03 Investors',
    title: 'Investors',
    description:
      'Long-term land opportunities and partnership enquiries with our Bengaluru-based team.',
    href: '/investors',
    image: '/media/pillar-nri.jpg',
    alt: 'Morning light and mist over green hills in South India.',
  },
];
---

<section class="section pillars" aria-labelledby="pillars-heading">
  <div class="container">
    <div class="pillars__header" data-reveal>
      <p class="eyebrow">How we work</p>
      <h2 id="pillars-heading" class="pillars__heading">Where we focus</h2>
    </div>

    <div class="pillars__grid" data-reveal-group>
      {
        pillars.map((pillar) => (
          <article class="pillar-card" data-reveal>
            <a href={pillar.href} class="pillar-card__link">
              <MediaSlot
                src={pillar.image}
                alt={pillar.alt}
                ratio="16/10"
                zoomOnHover={true}
              />
              <div class="pillar-card__body">
                <p class="eyebrow">{pillar.eyebrow}</p>
                <h3 class="pillar-card__title">{pillar.title}</h3>
                <p class="pillar-card__desc">{pillar.description}</p>
                <span class="pillar-card__cta">
                  Explore more <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .pillars__heading {
    font-size: var(--text-2xl);
  }

  @media (min-width: 1024px) {
    .pillars__heading {
      font-size: var(--text-3xl);
    }
  }

  .pillars__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .pillars__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .pillar-card {
    display: flex;
  }

  .pillar-card__link {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text-primary);
    transition: border-color var(--motion-fast) var(--ease-out);
  }

  .pillar-card__link:hover {
    opacity: 1;
    border-bottom-color: var(--color-accent-text);
  }

  .pillar-card__link:active {
    opacity: 0.88;
  }

  .pillar-card__body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }

  .pillar-card__title {
    font-size: var(--text-xl);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pillar-card__desc {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    flex: 1 1 auto;
  }

  .pillar-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-accent-text);
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .pillar-card__link:hover .pillar-card__cta {
    transform: translateX(var(--space-1));
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar-card__link:hover .pillar-card__cta {
      transform: none;
    }
  }
</style>
