---
import MediaSlot from '../MediaSlot.astro';

const highlights = [
  {
    label: '01 Location advantage',
    text: 'Located in Sri Sathya Sai District on the Karnataka–Andhra Pradesh border, with highway connectivity to Bengaluru and surrounding regions.',
  },
  {
    label: '02 Nature and lifestyle',
    text: 'Planned with open green cover, mature trees, and wide internal roads for daily living.',
  },
  {
    label: '03 Long-term value',
    text: 'A plotted development built for families and investors who plan to hold land for decades.',
  },
];
---

<section class="section featured" aria-labelledby="featured-project-heading">
  <div class="container featured__inner">
    <div class="featured__top" data-reveal>
      <div class="featured__title-block">
        <p class="eyebrow">Featured project</p>
        <h2 id="featured-project-heading" class="featured__heading">
          Tiiger Trail – Phase I
        </h2>
        <p class="featured__tagline">Where Nature and Soul Meet</p>
      </div>
      <p class="featured__summary">
        Our flagship plotted development in Sri Sathya Sai District on the Karnataka–Andhra Pradesh border, planned around open space and greenery.
      </p>
    </div>

    <div class="featured__media">
      <MediaSlot
        src="/media/tiiger-trail.webp"
        alt="Aerial view of green trees, palms, and open land parcels in soft light."
        ratio="21/9"
        objectPosition="center 55%"
        zoomOnHover={true}
        revealScale={true}
      />
    </div>

    <div class="featured__highlights" data-reveal-group>
      {
        highlights.map((item) => (
          <div class="featured__highlight" data-reveal>
            <h3 class="featured__highlight-label">{item.label}</h3>
            <p class="featured__highlight-text">{item.text}</p>
          </div>
        ))
      }
    </div>

    <div class="featured__actions" data-reveal>
      <a href="/projects/tiiger-trail" class="btn btn--primary">
        Explore Tiiger Trail
      </a>
      <a href="/projects" class="btn btn--outline">View all projects</a>
    </div>
  </div>
</section>

<style>
  .featured {
    border-top: 1px solid var(--color-border-subtle);
  }

  .featured__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .featured__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: end;
  }

  @media (min-width: 1024px) {
    .featured__top {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--space-6);
    }
  }

  .featured__title-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .featured__heading {
    font-size: var(--text-2xl);
  }

  @media (min-width: 1024px) {
    .featured__heading {
      font-size: var(--text-3xl);
    }
  }

  .featured__tagline {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: var(--leading-heading);
    color: var(--color-accent-text);
  }

  .featured__summary {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .featured__highlights {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 1024px) {
    .featured__highlights {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .featured__highlight {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .featured__highlight-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .featured__highlight-text {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
