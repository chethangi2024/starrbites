---
interface Props {
  eyebrow?: string;
  heading?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Next step',
  heading = 'Start your land journey',
  text = 'Speak with our Bengaluru team about Tiiger Trail – Phase I, site visits, or investment enquiries.',
  ctaLabel = 'Talk to us',
  ctaHref = '/contact',
} = Astro.props;
---

<section class="closing-cta" aria-labelledby="closing-cta-heading">
  <div class="container">
    <hr class="divider-gold closing-cta__rule" />
    <div class="closing-cta__band" data-reveal>
      <div class="closing-cta__copy">
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="closing-cta-heading" class="closing-cta__heading">
          {heading}
        </h2>
        <p class="closing-cta__text">{text}</p>
      </div>
      <div class="closing-cta__actions">
        <a href={ctaHref} class="btn btn--primary">{ctaLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .closing-cta {
    padding-bottom: var(--space-6);
  }

  @media (min-width: 1024px) {
    .closing-cta {
      padding-bottom: var(--space-8);
    }
  }

  .closing-cta__rule {
    margin: 0;
  }

  .closing-cta__band {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    padding-top: var(--space-6);
  }

  @media (min-width: 1024px) {
    .closing-cta__band {
      flex-direction: row;
      align-items: flex-end;
      padding-top: var(--space-8);
    }
  }

  .closing-cta__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .closing-cta__heading {
    font-size: var(--text-2xl);
  }

  @media (min-width: 1024px) {
    .closing-cta__heading {
      font-size: var(--text-3xl);
    }
  }

  .closing-cta__text {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .closing-cta__actions {
    flex-shrink: 0;
  }
</style>
