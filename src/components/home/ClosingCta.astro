---
interface Props {
  eyebrow?: string;
  heading?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Next Step',
  heading = 'Start your land journey',
  text = 'Speak directly with our Bengaluru team about Tiiger Trail – Phase I, site visits, or NRI buying support.',
  ctaLabel = 'Talk to us',
  ctaHref = '/contact',
} = Astro.props;
---

<section class="section closing-cta" aria-labelledby="closing-cta-heading">
  <div class="container">
    <div class="closing-cta__panel" data-reveal>
      <hr class="divider-gold closing-cta__rule" />
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="closing-cta-heading" class="closing-cta__heading">
        {heading}
      </h2>
      <p class="closing-cta__text">{text}</p>
      <div class="closing-cta__actions">
        <a href={ctaHref} class="btn btn--primary">{ctaLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .closing-cta__panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 1024px) {
    .closing-cta__panel {
      padding: var(--space-7) var(--space-6);
    }
  }

  .closing-cta__rule {
    max-width: 120px;
    margin: 0;
  }

  .closing-cta__heading {
    font-size: var(--text-2xl);
  }

  @media (min-width: 1024px) {
    .closing-cta__heading {
      font-size: var(--text-3xl);
    }
  }

  .closing-cta__text {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .closing-cta__actions {
    margin-top: var(--space-2);
  }
</style>
